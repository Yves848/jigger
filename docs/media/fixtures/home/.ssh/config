# Fixture de capture — ~/.ssh/config
#
# Des serveurs inventés, et c'est le point : une capture du sélecteur SSH montre
# le contenu d'un ~/.ssh/config, donc l'infrastructure de qui l'a produite. Celle-ci
# ne montre que ce fichier, identique sur les trois plateformes — la capture macOS
# et la capture Omarchy proposent donc exactement les mêmes hôtes.
#
# Il est monté en posant HOME sur docs/media/fixtures/home le temps de la capture :
# jigger lit $HOME/.ssh/config sans surcharge possible (internal/ssh/manager.go).

# Un Include, pour que la capture prouve qu'ils sont suivis.
Include conf.d/*.conf

Host passerelle
  HostName passerelle.exemple.net
  User yves

Host nas
  HostName 192.168.1.20
  User admin

Host proxmox
  HostName 192.168.1.10
  User root

Host omarchy
  HostName 192.168.1.31

Host windows
  HostName 192.168.1.32

# Un motif, et non un hôte : jigger l'écarte, comme « Host * ». Sa présence dans le
# fixture n'est pas décorative — elle vérifie l'écart à chaque capture.
Host *.exemple.net
  User yves

Host *
  ServerAliveInterval 60
