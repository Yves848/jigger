# Cibles de publication — à copier en `deploy.env` (non versionné) et remplir.
#
#   cp deploy.env.example deploy.env
#
# Ces valeurs décrivent un réseau privé : elles ne sont jamais commitées.
# Le dépôt est public.

# Cible SSH du conteneur nginx qui sert le site.
WEB_HOST=

# Cible SSH du proxy Caddy qui publie le domaine en HTTPS.
PROXY_HOST=

# Facultatif. Ce que le proxy doit joindre pour atteindre le site.
# Par défaut : l'hôte de WEB_HOST, port 80.
# WEB_ORIGIN=
