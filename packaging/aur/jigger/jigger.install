# Le binaire seul ne complète rien : sans la ligne `source`, rien n'apparaît et
# rien ne le dit au moment de l'installation. D'où ce message.
post_install() {
  cat <<'MSG'
  Ajoutez cette ligne à ~/.zshrc, puis relancez le shell (exec zsh) :

      source /usr/share/zsh/plugins/jigger/jigger.plugin.zsh

  Tapez ensuite « pacman -S fire » sans appuyer sur Entrée : le cadre doit
  apparaître sous l'invite. Guide complet : https://jigger.yg-devworks.com/parcours.html
MSG
}

post_upgrade() {
  post_install
}
